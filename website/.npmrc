# needed to prevent bad npm that has min-release-age but not exclude
engine-strict=true

min-release-age=14
# AUDITED 2026-10-11 — the previous 10 excludes were ALL dead and were removed.
# Each min-release-age-exclude[] switches the 14-day supply-chain cooldown OFF for
# one package. The convention here was "remove when > 2wks old" and nothing fails
# when that passes, so they rot: 9 of the 10 were 64-76 days past their window
# (fast-uri, js-yaml, nanoid, mermaid, dompurify, minimatch, postcss,
# brace-expansion, @nous-research/image-size) and the 10th (undici) matched
# nothing in the lockfile at all.
#
# An exclude is doing work IFF the version the lockfile RESOLVES is younger than
# the gate; once aged past, the version is allowed anyway and the exclude only
# subtracts protection. Check with ~/.hermes/scripts/npmrc-exclude-resolver.py
# (read-only, no install), or by removing it and confirming package-lock.json is
# byte-identical under a GATE-AWARE npm — this project's engines require
# npm >=11.17.0 precisely so the gate is real.
#
# The LEGITIMATE case for an exclude is a security fix published inside the
# window, with no aged version above the vulnerable ceiling. Date it, so the
# expiry audit flags it on the day it stops being needed, and remove it then.
# There are none at present.
# (follow-redirects left 2026-11-09: 1.16.2 aged past the gate 2026-11-08.)
# (joi left 2026-11-12: 17.13.9 aged past the gate 2026-11-11 10:04 UTC; the
# 17.13.9 pin itself stays, in package.json overrides.)
