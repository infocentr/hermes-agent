# needed to prevent bad npm that has min-release-age but not exclude
engine-strict=true

min-release-age=14
# AUDITED 2026-10-11 — the previous 10 excludes were ALL dead and were removed.
# Each min-release-age-exclude[] switches the 14-day supply-chain cooldown OFF for
# one package. The convention here was "remove when > 2wks old" and nothing fails
# when that passes, so they rot: 9 of the 10 were 64-76 days past their window
# (fast-uri, js-yaml, nanoid, mermaid, dompurify, minimatch, postcss,
# brace-expansion, @nous-research/image-size) and the 10th (undici) matched
# nothing in the lockfile at all.
#
# An exclude is doing work IFF the version the lockfile RESOLVES is younger than
# the gate; once aged past, the version is allowed anyway and the exclude only
# subtracts protection. Check with ~/.hermes/scripts/npmrc-exclude-resolver.py
# (read-only, no install), or by removing it and confirming package-lock.json is
# byte-identical under a GATE-AWARE npm — this project's engines require
# npm >=11.17.0 precisely so the gate is real.
#
# The three below are the LEGITIMATE case: a security fix published inside the
# window, with no aged version above the vulnerable ceiling. Each is dated, so the
# expiry audit will flag it on the day it stops being needed. Remove it then.




# body-parser 1.20.9 (rel 2026-10-22) fixes GHSA-27r3-jxmh-p828 (high, DoS via trailing
# bytes after a chunk). Reached transitively through express ~1.20.5; 1.20.9 satisfies
# that range, so an override alone is enough. EXPIRES 2026-11-05.
min-release-age-exclude[]=body-parser

# follow-redirects 1.16.2 fixes GHSA-mrwp-f3q8-3g9p (high): a cross-realm
# sensitiveHeaders array is discarded, so custom credentials follow a redirect to
# another origin. Both 1.16.0 and the pinned 1.16.1 are vulnerable. Reached
# transitively through http-proxy -> webpack-dev-server (declares ^1.0.0).
# (rel 2026-10-25) EXPIRES 2026-11-08.
min-release-age-exclude[]=follow-redirects

# joi 17.13.9 fixes GHSA-4528-x5fx-h6hg (high): quadratic-time split in
# string().email({ multiple: true }) allows denial of service. The advisory covers
# the 17.x line as >=17.1.1 <17.13.9, including the pinned 17.13.8. Reached
# through @docusaurus/types and @docusaurus/utils-validation (both ^17.9.2), so
# the 17.x fix is the right one here, not the 18.3.1 the root tree takes.
# (rel 2026-10-28) EXPIRES 2026-11-11.
min-release-age-exclude[]=joi
