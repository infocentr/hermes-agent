# needed to prevent bad npm that has min-release-age but not exclude
engine-strict=true

min-release-age=14
# Every min-release-age-exclude[] below switches the 14-day supply-chain cooldown
# OFF for one package. They get added for good reasons — a vuln fix you cannot
# wait two weeks for — with a comment saying "remove this when > 2wks old".
# Nothing fails when that passes, so they accumulate: at the time of this change
# 24 of the 25 entries were 14-128 days past their own stated window.
#
# An exclude is doing work IFF the version this repo's package-lock.json RESOLVES
# is younger than the gate. Once it has aged past, that version is allowed anyway,
# so the exclude buys nothing and only subtracts protection. Audited against this
# repo's own lockfile, every entry below was removable on that test:
#
#   safe-content-frame 128d   rolldown / @rolldown/*   77d
#   lightningcss        86d   @assistant-ui/*          76d
#   react-router        84d   assistant-stream         76d
#   @radix-ui/* radix-ui 82d  vite                     76d
#   tar concurrently    82d   dompurify                72d
#   postcss             82d   mermaid                  71d
#   minimatch           79d   nanoid                   68d
#   @oxc-project/types  79d   fast-uri                 52d
#   assistant-cloud     78d   js-yaml                  49d
#                             @eslint/*                41d
#                             brace-expansion          30d
#                             source-map-js            14d
#
# The vite / rolldown / @oxc-project/types set goes too: rolldown/rolldown#10337
# is long since shipped and the resolved rolldown is 1.2.1, so the ETARGET hazard
# the old comment described no longer applies.
#
# eslint is KEPT, and is structural rather than temporary: eslint ships faster
# than the 14-day gate, so the resolved version is routinely inside the window
# (10.12.0, released 2026-10-02). Removing it forces a downgrade on the next
# install, so it is the one entry that is actually load-bearing.
#
# A note for anyone re-checking this: "remove it and see if package-lock.json
# changes" only answers the question under an npm that implements the feature.
# npm 11.8.0 and 11.6.2 warn `Unknown project config "min-release-age"`, and a
# gate that never runs cannot move the lockfile — so under those npms the test
# reports "inert" for a load-bearing exclude just as happily. engine-strict above
# is what keeps such an npm out. Verified with npm 12.0.2 / node 26.7.0: a
# lock-only install with the 24 entries removed leaves package-lock.json
# byte-identical.
min-release-age-exclude[]=eslint
