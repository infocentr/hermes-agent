# needed to prevent bad npm that has min-release-age but not exclude
engine-strict=true

min-release-age=14

# WHY THIS LIST IS SHORT (audited 2026-10-23, after the 380-commit merge)
#
# Every `min-release-age-exclude[]` switches the 14-day supply-chain cooldown OFF
# for a package. They are added for good reasons — a vuln fix you cannot wait two
# weeks for — with a comment saying "remove when > 2wks old", and then nothing
# ever fails when that passes. Upstream's list had grown back to 27; 20 were dead.
#
# The version-independent test, which needs no install: an exclude is doing work
# IFF the version the lockfile RESOLVES is younger than the gate. Older than the
# gate and that version is allowed anyway, so the exclude buys nothing and only
# removes protection. ~/.hermes/scripts/npmrc-exclude-resolver.py computes that
# from package-lock.json + registry publish dates, read-only.
#
# eslint was ALSO removed, on 2026-10-23, by BOSS's explicit decision. It had
# been marked `# standing` on the theory that eslint ships faster than the
# 14-day gate, so the exclude would be load-bearing most of the time. The
# resolver disagreed on the day: resolved eslint@10.12.0 was 21 days old, i.e.
# the exclude was buying nothing right then. Keeping an inert exclude leaves the
# cooldown switched off for no benefit, so it went. Expect it to bite only when
# upstream bumps eslint to a release younger than 14 days — at which point the
# gate HOLDS that bump rather than downgrading anything already resolved. If
# that becomes a recurring nuisance, re-add it and mark it standing again; do not
# treat this note as a prohibition either way.
#
# It put 20 of 27 at 15-137 days past the window (the whole assistant-ui/radix-ui
# set, react-router, tar, concurrently, fast-uri, minimatch, brace-expansion,
# js-yaml, nanoid, mermaid, lightningcss, postcss, source-map-js,
# http-cache-semantics, safe-content-frame, @eslint/*). All removed.
#
# DO NOT "confirm" a removal with `npm install --package-lock-only` and a
# byte-identical package-lock.json. That test is VACUOUS against a complete,
# satisfying lockfile, even under the gate-aware npm. Measured 2026-10-23:
# removing the LOAD-BEARING electron exclude (resolved 44.9.3, then 2 days old,
# squarely inside the window) left the lockfile byte-identical too — npm had no
# reason to re-resolve anything, and min-release-age only applies when it picks
# a NEW version. A test that cannot fail is not evidence. The resolver, which
# compares resolved versions against registry publish dates, is the oracle.
#
# engine-strict=true above still matters for a different reason: the system
# (11.8.0) and nvm (11.6.2) npms do not implement min-release-age at all and
# would silently install inside the window.





# electron 44.9.3 backports upstream Chromium/V8 security fixes, and 44.9.1+ carries the
# eMudhra root distrust per #142533. remove when 44.9.3 is > 2wks old (rel 2026-10-21)
min-release-age-exclude[]=electron



# follow-redirects 1.16.2 fixes GHSA-mrwp-f3q8-3g9p (high): a cross-realm
# sensitiveHeaders array is discarded, so custom credentials follow a redirect to
# another origin. 1.16.0-1.16.1 are both vulnerable and 1.16.1 is what the pin
# already named, so there is no aged version above the ceiling to fall back to.
# Reached transitively through axios (declares ^1.16.0), so the override alone is
# enough. (rel 2026-10-25) EXPIRES 2026-11-08.
min-release-age-exclude[]=follow-redirects

# joi 18.3.1 fixes GHSA-4528-x5fx-h6hg (high): quadratic-time split in
# string().email({ multiple: true }) allows denial of service. The advisory covers
# >=18.0.0 <18.3.1, i.e. every 18.x including the 18.2.9 the pin already named.
# Reached transitively through wait-on (declares ^18.2.9). (rel 2026-10-28)
# EXPIRES 2026-11-11.
min-release-age-exclude[]=joi
