# needed to prevent bad npm that has min-release-age but not exclude
engine-strict=true

min-release-age=14
# WHY ONLY ONE EXCLUDE IS LEFT (audited 2026-10-11)
#
# Every `min-release-age-exclude[]` switches the supply-chain cooldown OFF for a
# package. They get added for good reasons — a vuln fix you cannot wait two weeks
# for — with a comment saying "remove when > 2wks old", and then nothing ever
# fails when that passes. This file had accumulated 24 of them; 23 were dead.
#
# Removability is decided by "remove it and see if package-lock.json changes" ONLY
# with a gate-aware npm. Use the pm-managed toolchain:
#   ~/.hermes/tools/npm-12.0.2-linux-x64/bin + node-26.7.0-linux-x64/bin
# The system npm (11.8.0) and nvm's (11.6.2) do NOT implement min-release-age — they
# warn `Unknown project config` — and a gate that never runs cannot move the
# lockfile, so under those npms the test reports "inert" for a load-bearing exclude
# just as happily. engine-strict=true above exists to keep such an npm out.
#
# The version-independent test, which needs no install: an exclude is doing work IFF
# the version the lockfile RESOLVES is younger than the gate. Older than the gate and
# the version is allowed anyway, so the exclude buys nothing and only removes
# protection. That is computed from package-lock.json + registry publish dates by
# ~/.hermes/scripts/npmrc-exclude-resolver.py (read-only, no install).
#
# Both agree here: the resolver put 19 of 20 past the window, and a lock-only install
# under npm 12.0.2 after removing them left package-lock.json byte-identical.
#
# On 2026-10-11 that put 19 of 20 entries at 27-125 days past the window —
# including the whole vite/rolldown/@oxc-project set (rolldown/rolldown#10337 is
# long since shipped; resolved rolldown is 1.2.1 from 2026-07-29) and every
# react-router / tar / concurrently / fast-uri / minimatch / brace-expansion /
# assistant-ui / radix-ui / lightningcss / postcss entry. All removed.
#
# eslint is the ONLY one still load-bearing, and it is structural rather than
# temporary: eslint ships faster than the 14-day gate, so the resolved version is
# routinely inside the window (eslint@10.12.0, released 2026-10-02, 9 days old at
# audit). Dropping this entry forces a downgrade on the next gate-aware install.
# Re-check with the resolver rather than deleting it on sight.
# standing — permanent by nature, not waiting to expire. Do not let a date-based
# audit talk you into removing it; ask npmrc-exclude-resolver.py instead.
min-release-age-exclude[]=eslint


# dompurify 3.4.17 (rel 2026-10-12) fixes GHSA-6688-9rhm-gjv2 and
# GHSA-p98j-92pf-mc4p (both low, IN_PLACE sanitiser leaks); our previous pin
# 3.4.13 is inside their <=3.4.15 range, and 3.4.16 is the first fix — there is
# no aged-past-the-gate version that is not vulnerable. EXPIRES 2026-10-26.
min-release-age-exclude[]=dompurify

# ip-address 10.7.4 (rel 2026-10-11) fixes GHSA-j6r3-76f7-8jcv and
# GHSA-h3mg-xc3c-68pw (both medium, <=10.7.0: isInSubnet comparing wrong and a
# quadratic Address6 parse diagnostic). Our previous pin 10.3.1 is inside that
# range. EXPIRES 2026-10-25.
min-release-age-exclude[]=ip-address
